FROM python:3.12-slim AS base
WORKDIR /app

FROM base AS builder
ARG CONTRACTS_SOURCE="syntara-plugin-contracts @ git+https://github.com/syntara-orchestration/syntara-plugin-sdk.git@ceb974ea4b27c6ecfee1fa14ba771f8ac65763ef#subdirectory=sdks/python/packages/contracts"
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY agent-runtime/pyproject.toml /app/pyproject.toml
COPY agent-runtime/manifest.yaml /app/manifest.yaml
COPY agent-runtime/src /app/src
RUN pip install --no-cache-dir "${CONTRACTS_SOURCE}" .

FROM base
COPY --from=builder /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=builder /usr/local/bin /usr/local/bin
USER 65532:65532
EXPOSE 50051
ENTRYPOINT ["python", "-m", "syntara_node_agent_runtime"]
