FROM python:3.12-slim AS base
WORKDIR /app

FROM base AS builder
# renovate: datasource=pypi depName=syntara-plugin-contracts
ARG CONTRACTS_VERSION=0.1.0a2
COPY script-runtime/pyproject.toml /app/pyproject.toml
COPY script-bash/manifest.yaml /app/manifest.yaml
COPY script-runtime/src /app/src
RUN pip install --no-cache-dir "syntara-plugin-contracts==${CONTRACTS_VERSION}" .

FROM base
COPY --from=builder /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /app/manifest.yaml /app/manifest.yaml
EXPOSE 50051
ENTRYPOINT ["python", "-m", "syntara_node_script.bash"]
