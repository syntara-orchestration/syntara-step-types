FROM registry.access.redhat.com/ubi9/python-312:1 AS builder

USER 0
WORKDIR /app

COPY script-runtime/requirements-konflux.txt /app/requirements-konflux.txt

# Konflux prefetches locked source distributions and build requirements.
# Local image tests use public PyPI wheels when the Hermeto cache is absent.
RUN if [ -n "${PIP_FIND_LINKS:-}" ]; then \
        yum install -y rust-toolset gcc-c++ make \
            && yum clean all; \
    fi \
    && python3.12 -m venv /app/.venv \
    && if [ -n "${PIP_FIND_LINKS:-}" ]; then \
        /app/.venv/bin/python -m pip install \
            --no-index \
            --find-links "${PIP_FIND_LINKS}" \
            --no-binary=:all: \
            --require-hashes \
            --no-deps \
            --no-cache-dir \
            --disable-pip-version-check \
            --requirement /app/requirements-konflux.txt; \
    else \
        /app/.venv/bin/python -m pip install \
            --only-binary=:all: \
            --require-hashes \
            --no-deps \
            --no-cache-dir \
            --disable-pip-version-check \
            --requirement /app/requirements-konflux.txt; \
    fi

FROM registry.access.redhat.com/ubi9/python-312-minimal:1 AS runtime

USER 0
WORKDIR /app

COPY LICENSE /licenses/LICENSE
COPY --from=builder /app/.venv /app/.venv
COPY script-python/manifest.yaml /app/manifest.yaml
COPY script-python/runtime.json /etc/syntara/runtime.json
COPY script-runtime/src /app/src

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/src" \
    SYNTARA_RUNTIME_CONFIG=/etc/syntara/runtime.json \
    SYNTARA_RUNTIME_GRPC_ADDRESS=0.0.0.0:50051 \
    SYNTARA_RUNTIME_GRPC_TLS_CERT=/run/secrets/server.crt \
    SYNTARA_RUNTIME_GRPC_TLS_KEY=/run/secrets/server.key \
    SYNTARA_RUNTIME_GRPC_TLS_CLIENT_CA=/run/secrets/client-ca.crt

EXPOSE 50051
USER 65532:65532
ENTRYPOINT ["python3.12", "-m", "syntara_plugin.runtime.server"]
