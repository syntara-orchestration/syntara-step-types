FROM registry.access.redhat.com/ubi9/python-312:1 AS base
WORKDIR /app

FROM base AS builder
USER 0
COPY --from=ghcr.io/astral-sh/uv:0.5.31 /uv /uvx /bin/
COPY pyproject.toml uv.lock /app/
COPY http-request/pyproject.toml /app/http-request/pyproject.toml
COPY script-runtime/pyproject.toml /app/script-runtime/pyproject.toml
COPY script-python/manifest.yaml /app/manifest.yaml
RUN uv sync --frozen --no-dev --no-build --no-install-workspace \
    --package syntara-node-script-runtime

FROM base
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/manifest.yaml /app/manifest.yaml
COPY script-runtime/src /app/src
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src"
EXPOSE 50051
USER 65532:65532
ENTRYPOINT ["python3.12", "-m", "syntara_node_script.python"]
