FROM python:3.12-slim AS base
WORKDIR /app

FROM base AS builder
ARG CONTRACTS_VERSION=0.1.0a5
COPY aap-job-template/pyproject.toml /app/pyproject.toml
COPY aap-job-template/manifest.yaml /app/manifest.yaml
COPY aap-job-template/src /app/src
RUN pip install --no-cache-dir "syntara-plugin-contracts==${CONTRACTS_VERSION}" .

FROM base
COPY --from=builder /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=builder /usr/local/bin /usr/local/bin
USER 65532:65532
EXPOSE 50051
ENTRYPOINT ["python", "-m", "syntara_node_aap_job_template"]
