FROM python:3.12-slim AS base
WORKDIR /app

FROM base AS builder
ARG SDK_VERSION=0.1.0a1
COPY script/pyproject.toml /app/pyproject.toml
COPY script/manifest.yaml /app/manifest.yaml
COPY script/src /app/src
# Resolve the published SDK and all step dependencies in a clean build context.
RUN pip install --no-cache-dir "syntara-plugin-sdk==${SDK_VERSION}" .

FROM base
COPY --from=builder /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=builder /usr/local/bin /usr/local/bin
EXPOSE 50051
ENTRYPOINT ["python", "-m", "syntara_node_script"]
