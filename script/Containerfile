FROM python:3.12-slim AS base
WORKDIR /app

FROM base AS builder
RUN pip install --no-cache-dir uv
# .sdk-contracts and .sdk-runtime are staged by `make node-image` from ../syntara-plugin-sdk
COPY .sdk-contracts /deps/contracts
COPY .sdk-runtime /deps/runtime
COPY script/pyproject.toml /app/pyproject.toml
COPY script/src /app/src
RUN uv pip install --system /deps/contracts
RUN uv pip install --system --no-deps /deps/runtime
RUN uv pip install --system --no-deps .

FROM base
COPY --from=builder /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /app/src /app/src
EXPOSE 50051
ENTRYPOINT ["python", "-m", "syntara_node_script"]
