FROM python:3.12-slim AS base
WORKDIR /app

FROM base AS builder
RUN pip install --no-cache-dir uv
# .sdk-runtime is staged by `make node-image` from ../syntara-plugin-sdk
COPY .sdk-runtime /deps/runtime
COPY http-request/pyproject.toml /app/pyproject.toml
COPY http-request/src /app/src
RUN uv pip install --system /deps/runtime "httpx>=0.28"
RUN uv pip install --system --no-deps .

FROM base
COPY --from=builder /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /app/src /app/src
EXPOSE 50051
ENTRYPOINT ["python", "-m", "syntara_node_http_request"]
