FROM python:3.12-slim AS base
WORKDIR /app

FROM base AS builder
ARG CONTRACTS_SOURCE="syntara-plugin-contracts @ git+https://github.com/syntara-orchestration/syntara-plugin-sdk.git@ceb974ea4b27c6ecfee1fa14ba771f8ac65763ef#subdirectory=sdks/python/packages/contracts"
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY http-request/pyproject.toml /app/pyproject.toml
COPY http-request/manifest.yaml /app/manifest.yaml
COPY http-request/src /app/src
# Install the unpublished host-operation ABI from the SDK feature commit and the step package.
RUN pip install --no-cache-dir "${CONTRACTS_SOURCE}" .

FROM base
COPY --from=builder /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=builder /usr/local/bin /usr/local/bin
COPY http-request/runtime.json /etc/syntara/runtime.json
ENV SYNTARA_RUNTIME_CONFIG=/etc/syntara/runtime.json \
    SYNTARA_RUNTIME_GRPC_ADDRESS=0.0.0.0:50051 \
    SYNTARA_RUNTIME_GRPC_TLS_CERT=/run/secrets/server.crt \
    SYNTARA_RUNTIME_GRPC_TLS_KEY=/run/secrets/server.key \
    SYNTARA_RUNTIME_GRPC_TLS_CLIENT_CA=/run/secrets/client-ca.crt
USER 65532:65532
EXPOSE 50051
ENTRYPOINT ["python", "-m", "syntara_plugin.runtime.server"]
