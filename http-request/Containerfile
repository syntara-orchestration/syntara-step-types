zzFROM python:3.12-slim AS base
WORKDIR /app

FROM base AS builder
# renovate: datasource=pypi depName=syntara-plugin-contracts
ARG CONTRACTS_VERSION=0.1.0a4
COPY http-request/pyproject.toml /app/pyproject.toml
COPY http-request/manifest.yaml /app/manifest.yaml
COPY http-request/src /app/src
# Resolve the published runtime contracts and all step dependencies in a clean build context.
RUN pip install --no-cache-dir "syntara-plugin-contracts==${CONTRACTS_VERSION}" .

FROM base
COPY --from=builder /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=builder /usr/local/bin /usr/local/bin
EXPOSE 50051
ENTRYPOINT ["python", "-m", "syntara_node_http_request"]
